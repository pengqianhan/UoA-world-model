{
  "name": "uoa-world-model",
  "version": "0.1.0",
  "private": true,
  "description": "Unofficial 3D map of University of Auckland buildings, floors and teaching rooms",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "e2e": "playwright test",
    "data:fetch": "tsx scripts/fetch-mapsindoors.ts && tsx scripts/fetch-osm.ts && tsx scripts/fetch-calendar.ts",
    "data:build": "tsx scripts/build-data.ts",
    "data:classes": "tsx scripts/fetch-classes.ts"
  },
  "dependencies": {
    "@preact/signals": "^2.11.3",
    "preact": "^11.0.1",
    "three": "^0.186.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.0",
    "@preact/preset-vite": "^2.10.6",
    "@types/node": "^26.6.5",
    "@types/three": "^0.186.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.4"
  },
  "engines": {
    "node": ">=22.12"
  }
}
